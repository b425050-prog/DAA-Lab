# Normalize text files across Windows and GNU/Linux
* text=auto

*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.dat text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Compiled executables, documents, and visual assets are binary
*.exe binary
*.pdf binary
*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.zip binary
